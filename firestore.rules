rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function member(chatId) {
      return signedIn() && request.auth.uid in
        get(/databases/$(database)/documents/chats/$(chatId)).data.members;
    }
    match /profiles/{userId} {
      // Signed-in users can search by share code. Never store private emails in these docs.
      allow get, list: if signedIn();
      allow create: if signedIn() && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['displayName', 'code', 'status', 'createdAt'])
        && request.resource.data.keys().hasAll(['displayName', 'code', 'status', 'createdAt'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 2
        && request.resource.data.displayName.size() <= 32
        && request.resource.data.code is string
        && request.resource.data.code.size() == 12
        && request.resource.data.status is string
        && request.resource.data.status.size() <= 100
        && request.resource.data.createdAt == request.time;
      allow update: if signedIn() && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'status'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 2
        && request.resource.data.displayName.size() <= 32
        && request.resource.data.status is string
        && request.resource.data.status.size() <= 100;
      allow delete: if false;
    }
    match /chats/{chatId} {
      allow get, list: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['members', 'title', 'createdBy', 'createdAt'])
        && request.resource.data.keys().hasAll(['members', 'title', 'createdBy', 'createdAt'])
        && request.resource.data.members is list
        && request.resource.data.members.size() >= 2
        && request.resource.data.members.size() <= 8
        && request.auth.uid in request.resource.data.members
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 40
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
      match /messages/{messageId} {
        allow get, list: if member(chatId);
        allow create: if member(chatId)
          && request.resource.data.keys().hasOnly(['sender', 'text', 'sentAt'])
          && request.resource.data.keys().hasAll(['sender', 'text', 'sentAt'])
          && request.resource.data.sender == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 4000
          && request.resource.data.sentAt == request.time;
        allow update, delete: if false;
      }
    }
  }
}
